{
  "manifest_version": 3,
  "name": "Chrome Ad Blocker",
  "version": "0.1.0",
  "description": "A basic Manifest V3 ad blocker.",
  "permissions": ["declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "basic_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
